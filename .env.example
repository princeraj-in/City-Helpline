# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional overrides; defaults load from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Upstash Redis Configuration for Persistent Shared Rate Limiting (Serverless & Multi-Instance)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudinary Image Upload Configuration (Client-Side & Server-Signed)
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# Cloudinary Server-Side Signature Keys (For High-Security Cryptographically Signed Uploads)
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_CLOUD_NAME=""

# Cloudinary Upload Preset Security Guidelines:
# 1. Mode: Unsigned (or Signed via /api/upload/sign)
# 2. Folder: studolink_uploads
# 3. Allowed Formats: jpg, jpeg, png, webp, heic
# 4. Max File Size: 10 MB (Client pre-compresses to < 500 KB)
# 5. Max Dimensions: 1600 x 1600 px (c_limit,w_1600,h_1600,q_auto,f_auto)
# 6. Disallow overwrite, public ID manipulation, and raw file execution.

# Firebase Admin SDK Service Account (JSON string or path to service account key file)
# Used by server-side role management to cryptographically sign Custom Claims and manage roles_admins
FIREBASE_SERVICE_ACCOUNT_KEY=""



