{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "contributor", "admin"] },
        "createdAt": { "type": "number" },
        "lastLogin": { "type": "number" },
        "banned": { "type": "boolean" },
        "phone": { "type": "string" },
        "businessName": { "type": "string" },
        "businessType": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "photoURL": { "type": "string" },
        "themePreference": { "type": "string", "enum": ["light", "dark", "system"] },
        "savedListings": { "type": "array", "items": { "type": "string" } },
        "notifications": { "type": "boolean" },
        "isStudentVerified": { "type": "boolean" },
        "studentVerificationStatus": { "type": "string", "enum": ["none", "pending", "verified", "rejected"] },
        "studentVerificationData": { "type": "object" },
        "isOwnerVerified": { "type": "boolean" }
      },
      "required": ["uid", "name", "email", "role", "createdAt"]
    },
    "Listing": {
      "title": "Listing",
      "description": "A listing for PG, Hostel, etc.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "price": { "type": "number" },
        "contact": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "featured": { "type": "boolean" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "number" },
        "averageRating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "isVerifiedPG": { "type": "boolean" },
        "pgVerificationStatus": { "type": "string", "enum": ["none", "pending", "verified", "rejected"] },
        "pgVerificationData": { "type": "object" }
      },
      "required": ["title", "description", "category", "city", "address", "price", "contact", "images", "status", "featured", "authorId", "authorName", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "A review for a listing",
      "type": "object",
      "properties": {
        "listingId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["listingId", "userId", "userName", "rating", "comment", "createdAt"]
    },
    "MarketplaceItem": {
      "title": "MarketplaceItem",
      "description": "Student secondhand marketplace items (books, coolers, cycles, furniture)",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string" },
        "condition": { "type": "string" },
        "city": { "type": "string" },
        "area": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "sellerPhone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "sold"] },
        "createdAt": { "type": "number" },
        "featured": { "type": "boolean" },
        "isStudentVerified": { "type": "boolean" }
      },
      "required": ["title", "description", "price", "category", "condition", "city", "images", "sellerId", "sellerName", "sellerPhone", "status", "createdAt"]
    },
    "RoommateProfile": {
      "title": "RoommateProfile",
      "description": "Student roommate and flatmate profiles for room sharing",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPhone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "city": { "type": "string" },
        "locality": { "type": "string" },
        "budgetMin": { "type": "number" },
        "budgetMax": { "type": "number" },
        "roomType": { "type": "string" },
        "targetExam": { "type": "string" },
        "habits": { "type": "object" },
        "bio": { "type": "string" },
        "moveInDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "found"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "photoURL": { "type": "string" }
      },
      "required": ["userId", "userName", "userPhone", "city", "locality", "budgetMin", "budgetMax", "roomType", "targetExam", "status", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "In-app direct chat thread between students and listing providers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "participantData": { "type": "object" },
        "listingContext": { "type": "object" },
        "lastMessage": { "type": "string" },
        "lastMessageSenderId": { "type": "string" },
        "lastMessageTimestamp": { "type": "object" },
        "unreadCount": { "type": "object" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["id", "participants", "participantData"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a chat conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "object" },
        "read": { "type": "boolean" }
      },
      "required": ["conversationId", "senderId", "senderName", "text"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Secure database-backed RBAC role document for administrators",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin"] },
        "assignedBy": { "type": "string" },
        "assignedAt": { "type": "number" }
      },
      "required": ["uid", "email", "role"]
    },
    "StudentPrivateVerification": {
      "title": "StudentPrivateVerification",
      "description": "Private student ID card proof, roll number, and verification credentials stored securely away from public user document",
      "type": "object",
      "properties": {
        "collegeOrCoaching": { "type": "string" },
        "rollOrIdNumber": { "type": "string" },
        "courseOrExam": { "type": "string" },
        "idProofUrl": { "type": "string" },
        "isLiveCameraCaptured": { "type": "boolean" },
        "submittedAt": { "type": "number" },
        "verifiedAt": { "type": "number" },
        "reviewedBy": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["collegeOrCoaching", "rollOrIdNumber", "courseOrExam"]
    },
    "ListingPrivateVerification": {
      "title": "ListingPrivateVerification",
      "description": "Private owner electricity bill, consumer number, and property verification credentials stored securely away from public listing document",
      "type": "object",
      "properties": {
        "electricityConsumerNumber": { "type": "string" },
        "subMeterRateDeclared": { "type": "number" },
        "caretakerName": { "type": "string" },
        "caretakerPhone": { "type": "string" },
        "ownerGovtIdType": { "type": "string" },
        "physicalInspectionDone": { "type": "boolean" },
        "submittedAt": { "type": "number" },
        "verifiedAt": { "type": "number" },
        "reviewedBy": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["electricityConsumerNumber", "subMeterRateDeclared"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/StudentPrivateVerification" },
      "description": "Protected private subcollection for sensitive student ID verification proofs & credentials"
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Listings"
    },
    "/listings/{listingId}/private/{docId}": {
      "schema": { "$ref": "#/entities/ListingPrivateVerification" },
      "description": "Protected private subcollection for sensitive property verification, consumer numbers, and electricity documents"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Reviews"
    },
    "/marketplace_items/{itemId}": {
      "schema": { "$ref": "#/entities/MarketplaceItem" },
      "description": "Student marketplace items"
    },
    "/roommate_profiles/{profileId}": {
      "schema": { "$ref": "#/entities/RoommateProfile" },
      "description": "Student flatmate / roommate profiles"
    },
    "/conversations/{convId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Chat conversations between users"
    },
    "/conversations/{convId}/messages/{msgId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Real-time messages in a conversation"
    },
    "/roles_admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Secure database RBAC collection for administrators"
    }
  }
}
